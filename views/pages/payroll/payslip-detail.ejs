<%- include('../../partials/header.ejs') %>

<main class="content-area fade-in">
  <div class="page-header mb-4 d-flex justify-content-between align-items-center">
    <div>
      <h1 class="h3 fw-bold">Payslip Detail</h1>
      <nav>
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="#">Home</a></li>
          <li class="breadcrumb-item"><a href="/payroll/my-payslips">Payslips</a></li>
          <li class="breadcrumb-item active">Detail</li>
        </ol>
      </nav>
    </div>
    <div>
      <button onclick="window.print()" class="btn btn-outline-primary me-2"><i class="fa-solid fa-print me-1"></i> Print Payslip</button>
      <a href="/payroll/my-payslips" class="btn btn-secondary">Back</a>
    </div>
  </div>

  <div class="card p-5 shadow-sm border-0 id="printableArea" style="max-width: 800px; margin: auto;">
    <div class="border-bottom pb-3 mb-4 d-flex justify-content-between align-items-center">
      <div>
        <h2 class="fw-bold text-primary mb-1"><i class="fa-solid fa-briefcase me-2"></i>EMS Pro</h2>
        <p class="text-muted small mb-0">Employee Management System & Payroll</p>
      </div>
      <div class="text-end">
        <h4 class="fw-bold mb-0">PAYSLIP</h4>
        <p class="text-muted small mb-0">Month: <%= payslip.month %></p>
      </div>
    </div>

    <div class="row g-3 mb-4 bg-light p-3 rounded">
      <div class="col-sm-6">
        <p class="text-muted small mb-1">Employee Name</p>
        <p class="fw-bold mb-0"><%= payslip.employee ? payslip.employee.name : 'N/A' %></p>
      </div>
      <div class="col-sm-6">
        <p class="text-muted small mb-1">Email</p>
        <p class="fw-bold mb-0"><%= payslip.employee ? payslip.employee.email : 'N/A' %></p>
      </div>
      <div class="col-sm-6">
        <p class="text-muted small mb-1">Role / Department</p>
        <p class="fw-bold text-capitalize mb-0"><%= payslip.employee ? payslip.employee.role : '' %> (<%= payslip.employee && payslip.employee.department ? payslip.employee.department.name : 'General' %>)</p>
      </div>
      <div class="col-sm-6">
        <p class="text-muted small mb-1">Status</p>
        <p class="fw-bold mb-0">
          <% if(payslip.status === 'Paid') { %>
            <span class="badge bg-success">Paid</span>
          <% } else { %>
            <span class="badge bg-warning text-dark">Pending</span>
          <% } %>
        </p>
      </div>
    </div>

    <h5 class="fw-bold mb-3">Salary Breakdown</h5>
    <div class="table-responsive mb-4">
      <table class="table table-bordered align-middle">
        <thead class="table-light">
          <tr>
            <th>Description</th>
            <th class="text-end">Amount ($)</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Basic Salary</td>
            <td class="text-end fw-bold">$<%= payslip.basicSalary %></td>
          </tr>
          <tr>
            <td>Allowances (Bonus, Medical, Transport)</td>
            <td class="text-end text-success">+$<%= payslip.allowance %></td>
          </tr>
          <tr>
            <td>Deductions (Tax, Leaves)</td>
            <td class="text-end text-danger">-$<%= payslip.deduction %></td>
          </tr>
          <tr class="table-primary fs-5">
            <td class="fw-bold">Total Net Payable Salary</td>
            <td class="text-end fw-bold">$<%= payslip.netSalary %></td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="d-flex justify-content-between align-items-end mt-5 pt-4 border-top">
      <div>
        <p class="text-muted small mb-1">Payment Date</p>
        <p class="fw-bold mb-0"><%= payslip.paymentDate ? new Date(payslip.paymentDate).toLocaleDateString() : 'Pending' %></p>
      </div>
      <div class="text-center">
        <div style="border-bottom: 2px solid #333; width: 160px; margin-bottom: 5px;"></div>
        <p class="small text-muted mb-0">Authorized Signature</p>
      </div>
    </div>
  </div>
</main>

<%- include('../../partials/footer.ejs') %>
