<%- include('../../partials/header.ejs') %>

<main class="content-area fade-in">
  <div class="page-header mb-4">
    <div>
      <h1 class="h3 fw-bold">My Payslips</h1>
      <nav>
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="#">Home</a></li>
          <li class="breadcrumb-item active">My Payslips</li>
        </ol>
      </nav>
    </div>
  </div>

  <div class="card p-3 shadow-sm border-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead class="table-light">
          <tr>
            <th>#</th>
            <th>Salary Month</th>
            <th>Basic Salary</th>
            <th>Allowance</th>
            <th>Deductions</th>
            <th>Net Salary</th>
            <th>Status</th>
            <th>Payment Date</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          <% if(payslips && payslips.length > 0) { %>
            <% payslips.forEach((item, index)=> { %>
              <tr>
                <td><%= index + 1 %></td>
                <td class="fw-bold"><%= item.month %></td>
                <td>$<%= item.basicSalary %></td>
                <td class="text-success">+$<%= item.allowance %></td>
                <td class="text-danger">-$<%= item.deduction %></td>
                <td class="fw-bold text-primary">$<%= item.netSalary %></td>
                <td>
                  <% if(item.status === 'Paid') { %>
                    <span class="badge bg-success">Paid</span>
                  <% } else { %>
                    <span class="badge bg-warning text-dark">Pending</span>
                  <% } %>
                </td>
                <td><%= item.paymentDate ? new Date(item.paymentDate).toLocaleDateString() : 'N/A' %></td>
                <td>
                  <a href="/payroll/payslip/<%= item._id %>" class="btn btn-sm btn-outline-primary">
                    <i class="fa-solid fa-download me-1"></i> View / Print
                  </a>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="9" class="text-center text-muted py-4">No payslips found for your account.</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</main>

<%- include('../../partials/footer.ejs') %>
