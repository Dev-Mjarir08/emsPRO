<%- include('../../partials/header.ejs') %>

<main class="content-area fade-in">
  <div class="page-header mb-4 d-flex justify-content-between align-items-center">
    <div>
      <h1 class="h3 fw-bold">All Tasks</h1>
      <nav>
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="/admin/dashboard">Home</a></li>
          <li class="breadcrumb-item active">Tasks</li>
        </ol>
      </nav>
    </div>
    <div>
      <a href="/task/create" class="btn btn-primary"><i class="fa-solid fa-plus me-1"></i> Create Task</a>
    </div>
  </div>

  <div class="card p-3 shadow-sm border-0">
    <div class="table-responsive">
      <table id="dataTable" class="table table-hover align-middle">
        <thead class="table-light">
          <tr>
            <th>#</th>
            <th>Title</th>
            <th>Price / Value</th>
            <th>Assigned To</th>
            <th>Assigned By</th>
            <th>Deadline</th>
            <th>Priority</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if(tasks && tasks.length > 0) { %>
            <% tasks.forEach((item, index)=> { %>
              <tr>
                <td><%= index + 1 %></td>
                <td class="fw-bold"><%= item.title %></td>
                <td class="text-success fw-bold">$<%= item.price || 0 %></td>
                <td><%= item.assignedTo ? item.assignedTo.name : 'Unassigned' %></td>
                <td><%= item.assignedBy ? item.assignedBy.name : 'System' %></td>
                <td><%= item.deadline ? new Date(item.deadline).toLocaleDateString() : 'N/A' %></td>
                <td>
                  <% if(item.priority === 'High') { %>
                    <span class="badge bg-danger">High</span>
                  <% } else if(item.priority === 'Medium') { %>
                    <span class="badge bg-warning text-dark">Medium</span>
                  <% } else { %>
                    <span class="badge bg-info text-dark">Low</span>
                  <% } %>
                </td>
                <td>
                  <% if(item.status === 'Completed') { %>
                    <span class="badge bg-success">Completed</span>
                  <% } else if(item.status === 'In Progress') { %>
                    <span class="badge bg-primary">In Progress</span>
                  <% } else { %>
                    <span class="badge bg-secondary">Pending</span>
                  <% } %>
                </td>
                <td>
                  <a href="/task/edit/<%= item._id %>" class="btn btn-sm btn-outline-primary me-1" title="Edit">
                    <i class="fa-solid fa-pen"></i>
                  </a>
                  <a href="/task/dlt/<%= item._id %>" onclick="return confirm('Are you sure you want to delete this task?')" class="btn btn-sm btn-outline-danger" title="Delete">
                    <i class="fa-solid fa-trash"></i>
                  </a>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="8" class="text-center text-muted py-4">No tasks found.</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</main>

<%- include('../../partials/footer.ejs') %>
