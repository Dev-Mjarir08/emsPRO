<%- include('../../partials/header.ejs') %>

<% if(user && user.role === "hr"){ %>

<main class="content-area fade-in">

    <div class="page-header mb-4">
        <div>
            <h1 class="h3 fw-bold">HR Dashboard</h1>
            <nav>
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="#">Home</a></li>
                    <li class="breadcrumb-item active">HR Dashboard</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <div class="stat-card p-3 border rounded shadow-sm bg-white d-flex align-items-center justify-content-between">
                <div>
                    <p class="text-muted small mb-1">Total Employees</p>
                    <h3 class="fw-bold mb-0"><%= typeof totalEmployees !== 'undefined' ? totalEmployees : 0 %></h3>
                </div>
                <div class="stat-icon bg-primary text-white p-3 rounded-circle fs-4">
                    <i class="fa-solid fa-users"></i>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="stat-card p-3 border rounded shadow-sm bg-white d-flex align-items-center justify-content-between">
                <div>
                    <p class="text-muted small mb-1">Total System Tasks</p>
                    <h3 class="fw-bold mb-0"><%= typeof totalTasks !== 'undefined' ? totalTasks : 0 %></h3>
                </div>
                <div class="stat-icon bg-warning text-dark p-3 rounded-circle fs-4">
                    <i class="fa-solid fa-list-check"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex gap-2">
        <a href="/admin/view-emp" class="btn btn-primary"><i class="fa-solid fa-users me-1"></i> View Employees</a>
        <a href="/task/view" class="btn btn-outline-primary"><i class="fa-solid fa-tasks me-1"></i> Manage Tasks</a>
    </div>

</main>

<% } %>

<%- include('../../partials/footer.ejs') %>