<%- include('../../partials/header.ejs') %>

<main class="content-area fade-in">
  <div class="page-header mb-4">
    <div>
      <h1 class="h3 fw-bold">My Profile</h1>
      <nav>
        <ol class="breadcrumb mb-0">
          <li class="breadcrumb-item"><a href="/admin/dashboard">Home</a></li>
          <li class="breadcrumb-item active">Profile</li>
        </ol>
      </nav>
    </div>
  </div>

  <div class="row g-4">
    <!-- Left Profile Summary Card -->
    <div class="col-md-4">
      <div class="card p-4 text-center shadow-sm border-0 d-flex flex-column align-items-center">
        <div class="mb-3 d-flex justify-content-center">
          <% if(profileUser && profileUser.image) { 
               const formattedImg = profileUser.image.replace(/\\/g, '/');
               const imgSrc = (formattedImg.startsWith('/') || formattedImg.startsWith('http')) ? formattedImg : '/' + formattedImg;
          %>
            <img src="<%= imgSrc %>" class="rounded-circle img-thumbnail shadow-sm" style="width: 120px; height: 120px; object-fit: cover;" alt="Profile">
          <% } else { %>
            <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center fw-bold fs-1 shadow-sm" style="width: 120px; height: 120px;">
              <%= profileUser && profileUser.name ? profileUser.name.charAt(0).toUpperCase() : 'U' %>
            </div>
          <% } %>
        </div>

        <h4 class="fw-bold mb-1 text-center w-100"><%= profileUser ? profileUser.name : 'User' %></h4>
        <span class="badge bg-primary text-capitalize mb-3 px-3 py-2 text-wrap"><%= profileUser ? profileUser.role : '' %></span>

        <div class="w-100 mt-2">
          <a href="/edit-profile" class="btn btn-outline-primary btn-sm w-100 mb-2"><i class="fa-solid fa-user-pen me-1"></i> Edit Profile</a>
          <a href="/change-password" class="btn btn-outline-secondary btn-sm w-100"><i class="fa-solid fa-key me-1"></i> Change Password</a>
        </div>
      </div>
    </div>

    <!-- Right Details Card -->
    <div class="col-md-8">
      <div class="card p-4 shadow-sm border-0">
        <h5 class="fw-bold mb-3 border-bottom pb-2"><i class="fa-solid fa-id-card me-2 text-primary"></i>Profile Details</h5>
        <div class="row g-3">
          <div class="col-sm-6">
            <p class="text-muted small mb-1">Full Name</p>
            <p class="fw-bold text-dark fs-6 mb-0"><%= profileUser ? profileUser.name : 'N/A' %></p>
          </div>
          <div class="col-sm-6">
            <p class="text-muted small mb-1">Email Address</p>
            <p class="fw-bold text-dark fs-6 mb-0"><%= profileUser ? profileUser.email : 'N/A' %></p>
          </div>
          <div class="col-sm-6">
            <p class="text-muted small mb-1">Phone Number</p>
            <p class="fw-bold text-dark fs-6 mb-0"><%= profileUser && profileUser.phone ? profileUser.phone : 'N/A' %></p>
          </div>
          <div class="col-sm-6">
            <p class="text-muted small mb-1">Department</p>
            <p class="fw-bold text-dark fs-6 mb-0"><%= profileUser && profileUser.department ? profileUser.department.name : 'N/A' %></p>
          </div>
          <div class="col-sm-6">
            <p class="text-muted small mb-1">Role</p>
            <p class="fw-bold text-capitalize text-dark fs-6 mb-0"><%= profileUser ? profileUser.role : 'N/A' %></p>
          </div>
          <div class="col-sm-6">
            <p class="text-muted small mb-1">Joining Date</p>
            <p class="fw-bold text-dark fs-6 mb-0"><%= profileUser && profileUser.joiningDate ? new Date(profileUser.joiningDate).toLocaleDateString() : 'N/A' %></p>
          </div>
          <div class="col-12">
            <p class="text-muted small mb-1">Address</p>
            <p class="fw-bold text-dark fs-6 mb-0"><%= profileUser && profileUser.address ? profileUser.address : 'N/A' %></p>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('../../partials/footer.ejs') %>
