<%- include('../../partials/header.ejs') %>

<main class="content-area fade-in">
  <div class="page-header mb-4">
    <div>
      <h1 class="h3 fw-bold">Change Password</h1>
      <nav>
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="/profile">Profile</a></li>
          <li class="breadcrumb-item active">Change Password</li>
        </ol>
      </nav>
    </div>
  </div>

  <div class="card p-4 shadow-sm border-0 col-md-8">
    <% if(typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger mb-3"><%= error %></div>
    <% } %>

    <form class="row g-3" action="/change-password" method="post">
      <div class="col-12">
        <div class="form-floating">
          <input type="password" name="oldPassword" class="form-control" placeholder="Current Password" required />
          <label>Current Password</label>
        </div>
      </div>
      <div class="col-12">
        <div class="form-floating">
          <input type="password" name="newPassword" class="form-control" placeholder="New Password" required />
          <label>New Password</label>
        </div>
      </div>
      <div class="col-12 d-flex gap-2 mt-3">
        <button class="btn btn-primary px-4"><i class="fa-solid fa-key me-1"></i> Update Password</button>
        <a href="/profile" class="btn btn-outline-secondary px-4">Cancel</a>
      </div>
    </form>
  </div>
</main>

<%- include('../../partials/footer.ejs') %>
