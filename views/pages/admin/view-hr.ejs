<%- include('../../partials/header.ejs') %>

<main class="content-area fade-in">
  <div class="page-header mb-4 d-flex justify-content-between align-items-center">
    <div>
      <h1 class="h3 fw-bold">HR Management</h1>
      <nav>
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="/admin/dashboard">Home</a></li>
          <li class="breadcrumb-item active">HR</li>
        </ol>
      </nav>
    </div>
    <div>
      <a href="/admin/create-hr" class="btn btn-primary"><i class="fa-solid fa-plus me-1"></i> Add HR</a>
    </div>
  </div>

  <div class="card p-3 shadow-sm border-0">
    <div class="table-responsive">
      <table id="dataTable" class="table table-hover align-middle">
        <thead class="table-light">
          <tr>
            <th>#</th>
            <th>Name</th>
            <th>Email</th>
            <th>Department</th>
            <th>Phone</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if(hrList && hrList.length > 0) { %>
            <% hrList.forEach((item, index)=> { %>
              <tr>
                <td><%= index + 1 %></td>
                <td class="fw-bold"><%= item.name %></td>
                <td><%= item.email %></td>
                <td><span class="badge bg-secondary"><%= item.department ? item.department.name : 'N/A' %></span></td>
                <td><%= item.phone || 'N/A' %></td>
                <td>
                  <a href="/admin/edit-hr/<%= item._id %>" class="btn btn-sm btn-outline-primary me-1" title="Edit">
                    <i class="fa-solid fa-pen"></i>
                  </a>
                  <a href="/admin/dlt-hr/<%= item._id %>" onclick="return confirm('Are you sure you want to delete this HR user?')" class="btn btn-sm btn-outline-danger" title="Delete">
                    <i class="fa-solid fa-trash"></i>
                  </a>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="6" class="text-center text-muted py-4">No HR members found.</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</main>

<%- include('../../partials/footer.ejs') %>
