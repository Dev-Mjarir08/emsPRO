<%- include('../../partials/header.ejs') %>

<main class="content-area fade-in">
  <div class="page-header mb-4 d-flex justify-content-between align-items-center">
    <div>
      <h1 class="h3 fw-bold">Employees</h1>
      <nav>
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="/admin/dashboard">Home</a></li>
          <li class="breadcrumb-item active">Employees</li>
        </ol>
      </nav>
    </div>
    <div>
      <a href="/admin/create-emp" class="btn btn-primary"><i class="fa-solid fa-plus me-1"></i> Add Employee</a>
    </div>
  </div>

  <div class="card p-3 shadow-sm border-0">
    <div class="table-responsive">
      <table id="dataTable" class="table table-hover align-middle">
        <thead class="table-light">
          <tr>
            <th>#</th>
            <th>Name</th>
            <th>Email</th>
            <th>Department</th>
            <th>Phone</th>
            <th>Salary</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if(employee && employee.length > 0) { %>
            <% employee.forEach((item, index)=> { %>
              <tr>
                <td><%= index + 1 %></td>
                <td class="fw-bold">
                  <% if(item.image) { 
                       const imgPath = '/' + item.image.replace(/\\/g, '/').replace(/^\/+/, '');
                  %>
                    <img src="<%= imgPath %>" class="rounded-circle me-2" style="width: 35px; height: 35px; object-fit: cover;" alt="<%= item.name %>">
                  <% } else { %>
                    <span class="avatar-placeholder rounded-circle bg-primary text-white d-inline-flex align-items-center justify-content-center me-2 fw-bold" style="width: 35px; height: 35px; font-size: 14px;">
                      <%= item.name ? item.name.charAt(0).toUpperCase() : 'E' %>
                    </span>
                  <% } %>
                  <%= item.name %>
                </td>
                <td><%= item.email %></td>
                <td><span class="badge bg-info text-dark"><%= item.department ? item.department.name : 'N/A' %></span></td>
                <td><%= item.phone || 'N/A' %></td>
                <td>$<%= item.salary || 0 %></td>
                <td>
                  <a href="/admin/edit-emp/<%= item._id %>" class="btn btn-sm btn-outline-primary me-1" title="Edit">
                    <i class="fa-solid fa-pen"></i>
                  </a>
                  <a href="/admin/dlt-emp/<%= item._id %>" onclick="return confirm('Are you sure you want to delete this employee?')" class="btn btn-sm btn-outline-danger" title="Delete">
                    <i class="fa-solid fa-trash"></i>
                  </a>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="7" class="text-center text-muted py-4">No employees found.</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</main>

<%- include('../../partials/footer.ejs') %>