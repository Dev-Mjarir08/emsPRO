<%- include('../../partials/header.ejs') %>

<main class="content-area fade-in">
  <div class="page-header mb-4">
    <div>
      <h1 class="h3 fw-bold">Edit Department</h1>
      <nav>
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="/admin/dashboard">Home</a></li>
          <li class="breadcrumb-item"><a href="/admin/view-dpt">Departments</a></li>
          <li class="breadcrumb-item active">Edit</li>
        </ol>
      </nav>
    </div>
  </div>

  <div class="card p-4 shadow-sm border-0">
    <form class="row g-3" action="/admin/edit-dpt/<%= department._id %>" method="post">
      <div class="col-md-12">
        <div class="form-floating">
          <input type="text" value="<%= department.name %>" name="name" class="form-control" placeholder="Department Name" required />
          <label>Department Name</label>
        </div>
      </div>
      <div class="col-12">
        <label class="form-label">Description</label>
        <textarea class="form-control" name="description" rows="3"><%= department.description %></textarea>
      </div>
      <div class="col-12 d-flex gap-2 mt-3">
        <button class="btn btn-primary px-4"><i class="fa-solid fa-save me-1"></i> Update Department</button>
        <a href="/admin/view-dpt" class="btn btn-outline-secondary px-4">Cancel</a>
      </div>
    </form>
  </div>
</main>

<%- include('../../partials/footer.ejs') %>