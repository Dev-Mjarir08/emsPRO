<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />

    <title>EMS Pro</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <link rel="stylesheet" href="/assets/css/style.css" />
    <link rel="stylesheet" href="/assets/css/dashboard.css" />
    <link rel="stylesheet" href="/assets/css/animations.css" />
    <link rel="stylesheet" href="/assets/css/responsive.css" />
</head>

<body>

<div class="app-wrapper">

    <!-- Sidebar -->
    <aside class="sidebar" id="sidebar">

        <div class="sidebar-brand">
            <i class="fa-solid fa-briefcase"></i>
            <span>EMS Pro</span>
        </div>

        <ul class="sidebar-menu">

            <!-- MAIN -->
            <li class="menu-title">Main</li>

            <% if(user && user.role === "admin"){ %>

                <li>
                    <a href="/admin/dashboard">
                        <i class="fa-solid fa-gauge-high"></i>
                        Admin Dashboard
                    </a>
                </li>

            <% } %>

            <% if(user && user.role === "hr"){ %>

                <li>
                    <a href="/hr/dashboard">
                        <i class="fa-solid fa-user-tie"></i>
                        HR Dashboard
                    </a>
                </li>

            <% } %>

            <% if(user && user.role === "employee"){ %>

                <li>
                    <a href="/emp/dashboard">
                        <i class="fa-solid fa-user"></i>
                        Employee Dashboard
                    </a>
                </li>

            <% } %>


            <!-- MANAGEMENT -->

            <% if(user && (user.role === "admin" || user.role === "hr")){ %>

            <li class="menu-title">Management</li>

            <!-- Employees -->

            <li class="has-sub">

                <a href="#">
                    <i class="fa-solid fa-users"></i>
                    Employees
                    <i class="fa-solid fa-chevron-right arrow"></i>
                </a>

                <ul class="submenu">

                    <li>
                        <a href="/admin/view-emp">
                            View All Employees
                        </a>
                    </li>

                    <% if(user.role === "admin"){ %>

                    <li>
                        <a href="/admin/create-emp">
                            Add Employee
                        </a>
                    </li>

                    <% } %>

                </ul>

            </li>

            <% } %>


            <!-- HR -->

            <% if(user && user.role === "admin"){ %>

            <li class="has-sub">

                <a href="#">
                    <i class="fa-solid fa-user-shield"></i>
                    HR
                    <i class="fa-solid fa-chevron-right arrow"></i>
                </a>

                <ul class="submenu">

                    <li>
                        <a href="/admin/view-hr">
                            View HR List
                        </a>
                    </li>

                    <li>
                        <a href="/admin/create-hr">
                            Add HR
                        </a>
                    </li>

                </ul>

            </li>

            <% } %>


            <!-- DEPARTMENT -->

            <% if(user && user.role === "admin"){ %>

            <li class="has-sub">

                <a href="#">
                    <i class="fa-solid fa-building"></i>
                    Departments
                    <i class="fa-solid fa-chevron-right arrow"></i>
                </a>

                <ul class="submenu">

                    <li>
                        <a href="/admin/view-dpt">
                            View Departments
                        </a>
                    </li>

                    <li>
                        <a href="/admin/create-dpt">
                            Add Department
                        </a>
                    </li>

                </ul>

            </li>

            <% } %>


            <!-- TASKS -->

            <li class="menu-title">Tasks</li>

            <li class="has-sub">

                <a href="#">
                    <i class="fa-solid fa-list-check"></i>
                    Tasks
                    <i class="fa-solid fa-chevron-right arrow"></i>
                </a>

                <ul class="submenu">

                    <% if(user && (user.role === "admin" || user.role === "hr")){ %>

                    <li>
                        <a href="/task/view">
                            View All Tasks
                        </a>
                    </li>

                    <li>
                        <a href="/task/create">
                            Create Task
                        </a>
                    </li>

                    <% } %>

                    <li>
                        <a href="/task/my-tasks">
                            My Tasks
                        </a>
                    </li>

                </ul>

            </li>


            <!-- PAYROLL -->

            <li class="menu-title">Payroll</li>

            <li class="has-sub">

                <a href="#">
                    <i class="fa-solid fa-money-bill-wave"></i>
                    Payroll & Salary
                    <i class="fa-solid fa-chevron-right arrow"></i>
                </a>

                <ul class="submenu">

                    <% if(user && (user.role === "admin" || user.role === "hr")){ %>

                    <li>
                        <a href="/payroll/view">
                            View All Payrolls
                        </a>
                    </li>

                    <li>
                        <a href="/payroll/create">
                            Generate Payslip
                        </a>
                    </li>

                    <% } %>

                    <li>
                        <a href="/payroll/my-payslips">
                            My Payslips
                        </a>
                    </li>

                </ul>

            </li>


            <!-- ACCOUNT -->

            <li class="menu-title">
                Account
            </li>

            <li>
                <a href="/profile">
                    <i class="fa-solid fa-id-card"></i>
                    Profile
                </a>
            </li>

            <li>
                <a href="/edit-profile">
                    <i class="fa-solid fa-user-pen"></i>
                    Edit Profile
                </a>
            </li>

            <li>
                <a href="/change-password">
                    <i class="fa-solid fa-key"></i>
                    Change Password
                </a>
            </li>

            <li>
                <a href="/logout">
                    <i class="fa-solid fa-arrow-right-from-bracket"></i>
                    Logout
                </a>
            </li>

        </ul>

        <div class="sidebar-footer">
            &copy; 2026 EMS Pro
        </div>

    </aside>


    <!-- MAIN CONTENT -->

    <div class="main-content">

        <!-- TOPBAR -->

        <header class="topbar">

            <button class="menu-toggle" id="menuToggle">
                <i class="fa-solid fa-bars"></i>
            </button>

            <div class="search-box">

                <i class="fa-solid fa-magnifying-glass"></i>

                <input type="text"
                    class="form-control"
                    placeholder="Search employees, tasks..." />

            </div>

            <div class="ms-auto d-flex align-items-center gap-2">

                <button class="topbar-icon" id="themeToggle">
                    <i class="fa-solid fa-moon"></i>
                </button>

                <div class="dropdown">

                    <button class="btn border-0 bg-transparent p-0 d-flex align-items-center gap-2"
                        data-bs-toggle="dropdown">

                        <span class="user-avatar">
                            <%= user && user.name ? user.name.charAt(0).toUpperCase() : "U" %>
                        </span>

                        <span class="fw-bold me-1 d-none d-md-inline">
                            <%= user ? user.name : "User" %>
                        </span>

                        <i class="fa-solid fa-chevron-down text-muted small"></i>

                    </button>

                    <div class="dropdown-menu dropdown-menu-end">

                        <div class="px-3 py-2 border-bottom">

                            <strong>
                                <%= user ? user.name : "User" %>
                            </strong>

                            <div class="small text-muted text-capitalize">
                                <%= user ? user.role : "" %>
                            </div>

                        </div>

                        <a class="dropdown-item" href="/profile">

                            <i class="fa-solid fa-user me-2"></i>
                            Profile

                        </a>

                        <a class="dropdown-item" href="/edit-profile">

                            <i class="fa-solid fa-user-pen me-2"></i>
                            Edit Profile

                        </a>

                        <a class="dropdown-item text-danger"
                            href="/logout">

                            <i class="fa-solid fa-arrow-right-from-bracket me-2"></i>
                            Logout

                        </a>

                    </div>

                </div>

            </div>

        </header>

        <!-- PAGE CONTENT -->

        <div class="content-wrapper p-4">

            <% if(typeof success_msg !== 'undefined' && success_msg) { %>
                <div class="alert alert-success alert-dismissible fade show mb-3 shadow-sm border-0" role="alert">
                    <i class="fa-solid fa-circle-check me-2"></i><%= success_msg %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            <% } %>

            <% if(typeof error_msg !== 'undefined' && error_msg) { %>
                <div class="alert alert-danger alert-dismissible fade show mb-3 shadow-sm border-0" role="alert">
                    <i class="fa-solid fa-triangle-exclamation me-2"></i><%= error_msg %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            <% } %>